{
  "agents": {
    "defaults": {
      "workspace": "./workspace",
      "model": "your-model-here",
      "maxTokens": 8192,
      "temperature": 0.1,
      "maxToolIterations": 40,
      "memoryWindow": 100
    }
  },
  "channels": {
    "sendProgress": true,
    "sendToolHints": false,
    "whatsapp": {
      "enabled": false,
      "bridgeUrl": "ws://localhost:3001",
      "bridgeToken": "your-token-here",
      "allowFrom": []
    },
    "telegram": {
      "enabled": false,
      "token": "your-telegram-token",
      "allowFrom": [],
      "proxy": null,
      "replyToMessage": false
    },
    "discord": {
      "enabled": false,
      "token": "your-discord-token",
      "allowFrom": [],
      "gatewayUrl": "wss://gateway.discord.gg/?v=10&encoding=json",
      "intents": 37377
    },
    "feishu": {
      "enabled": false,
      "appId": "your-app-id",
      "appSecret": "your-app-secret",
      "encryptKey": "your-encrypt-key",
      "verificationToken": "your-verification-token",
      "allowFrom": []
    },
    "mochat": {
      "enabled": false,
      "baseUrl": "https://mochat.io",
      "socketUrl": "",
      "socketPath": "/socket.io",
      "socketDisableMsgpack": false,
      "socketReconnectDelayMs": 1000,
      "socketMaxReconnectDelayMs": 10000,
      "socketConnectTimeoutMs": 10000,
      "refreshIntervalMs": 30000,
      "watchTimeoutMs": 25000,
      "watchLimit": 100,
      "retryDelayMs": 500,
      "maxRetryAttempts": 0,
      "clawToken": "your-claw-token",
      "agentUserId": "your-agent-user-id",
      "sessions": [],
      "panels": [],
      "allowFrom": [],
      "mention": {
        "requireInGroups": false
      },
      "groups": {},
      "replyDelayMode": "non-mention",
      "replyDelayMs": 120000
    },
    "dingtalk": {
      "enabled": false,
      "clientId": "your-client-id",
      "clientSecret": "your-client-secret",
      "allowFrom": []
    },
    "email": {
      "enabled": false,
      "consentGranted": false,
      "imapHost": "your-imap-host",
      "imapPort": 993,
      "imapUsername": "your-username",
      "imapPassword": "your-password",
      "imapMailbox": "INBOX",
      "imapUseSsl": true,
      "smtpHost": "your-smtp-host",
      "smtpPort": 587,
      "smtpUsername": "your-username",
      "smtpPassword": "your-password",
      "smtpUseTls": true,
      "smtpUseSsl": false,
      "fromAddress": "your-email@example.com",
      "autoReplyEnabled": true,
      "pollIntervalSeconds": 30,
      "markSeen": true,
      "maxBodyChars": 12000,
      "subjectPrefix": "Re: ",
      "allowFrom": []
    },
    "slack": {
      "enabled": false,
      "mode": "socket",
      "webhookPath": "/slack/events",
      "botToken": "your-bot-token",
      "appToken": "your-app-token",
      "userTokenReadOnly": true,
      "replyInThread": true,
      "reactEmoji": "eyes",
      "groupPolicy": "mention",
      "groupAllowFrom": [],
      "dm": {
        "enabled": true,
        "policy": "open",
        "allowFrom": []
      }
    },
    "qq": {
      "enabled": false,
      "appId": "your-app-id",
      "secret": "your-secret",
      "allowFrom": []
    }
  },
  "providers": {
    "custom": {
      "apiKey": "your-api-key",
      "apiBase": "your-api-base",
      "extraHeaders": null
    },
    "anthropic": {
      "apiKey": "your-anthropic-key",
      "apiBase": null, 
      "extraHeaders": null
    },
    "openai": {
      "apiKey": "your-openai-key",
      "apiBase": null,
      "extraHeaders": null
    },
    "openrouter": {
      "apiKey": "your-openrouter-key",
      "apiBase": null,
      "extraHeaders": null
    },
    "deepseek": {
      "apiKey": "your-deepseek-key",
      "apiBase": null,
      "extraHeaders": null
    },
    "groq": {
      "apiKey": "your-groq-key",
      "apiBase": null,
      "extraHeaders": null
    },
    "zhipu": {
      "apiKey": "your-zhipu-key",
      "apiBase": null,
      "extraHeaders": null
    },
    "dashscope": {
      "apiKey": "your-dashscope-key",
      "apiBase": null,
      "extraHeaders": null
    },
    "vllm": {
      "apiKey": "your-vllm-key",
      "apiBase": null,
      "extraHeaders": null
    },
    "gemini": {
      "apiKey": "your-gemini-key",
      "apiBase": null,
      "extraHeaders": null
    },
    "moonshot": {
      "apiKey": "your-moonshot-key",
      "apiBase": null,
      "extraHeaders": null
    },
    "minimax": {
      "apiKey": "your-minimax-key",
      "apiBase": null,
      "extraHeaders": null
    },
    "aihubmix": {
      "apiKey": "your-aihubmix-key",
      "apiBase": null,
      "extraHeaders": null
    },
    "siliconflow": {
      "apiKey": "your-siliconflow-key",
      "apiBase": null,
      "extraHeaders": null
    },
    "volcengine": {
      "apiKey": "your-volcengine-key",
      "apiBase": null,
      "extraHeaders": null
    },
    "openaiCodex": {
      "apiKey": "your-codex-key",
      "apiBase": null,
      "extraHeaders": null
    },
    "githubCopilot": {
      "apiKey": "your-copilot-key",
      "apiBase": null,
      "extraHeaders": null
    }
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 18790,
    "heartbeat": {
      "enabled": true,
      "intervalS": 1800
    }
  },
  "tools": {
    "web": {
      "search": {
        "apiKey": "your-search-api-key",
        "maxResults": 5
      }
    },
    "exec": {
      "timeout": 60
    },
    "browserAgent": {
      "pythonPath": "path/to/python",
      "scriptPath": "path/to/script",
      "model": "your-model",
      "apiKey": "your-api-key",
      "apiBase": "your-api-base",
      "extraHeaders": null,
      "timeout": 600,
      "downloadDir": "path/to/downloads",
      "headless": false,
      "userDataDir": "path/to/user/data",  
      "cdpUrl": "http://localhost:9222"                                              
    },
    "restrictToWorkspace": false,
    "mcpServers": {}
  }
}